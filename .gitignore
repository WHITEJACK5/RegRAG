# Virtual environment — rebuildable with one command, never commit
.venv/

# Downloaded PDFs — spec rule: PDFs never committed to git
data/*.pdf

# Python build/cache artifacts
__pycache__/
*.pyc
.pytest_cache/

# Secrets — API keys live here, NEVER in git
.env

# Embedding index artifacts: data/index/dense.faiss is the deploy artifact
# (43-min rebuild on CPU, D7 measurement). Scratch indexes stay out.
.index/
*.faiss
!data/index/dense.faiss

# OS noise
.DS_Store
Thumbs.db